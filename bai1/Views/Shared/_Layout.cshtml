<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Thành Long Book</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/bai1.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Views/Shared/_Layout.cshtml.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body class="h-100 d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow ">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/Logo.png" style="height:90px;" />
                </a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="categoryDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Danh mục
                            </a>
                            <ul class="dropdown-menu category-dropdown" aria-labelledby="categoryDropdown">
                                @await Component.InvokeAsync("CategoryMenu")
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="TrackOrder" asp-action="Index">
                                <i class="bi bi-search"></i> Tra cứu đơn hàng
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="About">Giới thiệu</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Contact">Liên hệ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Event">Sự kiện</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        @* Cart Button *@
                        <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-primary position-relative">
                            <i class="fa-solid fa-cart-shopping"></i>
                            @{
                                var cart = Context.Session.GetString("cart");
                                int cartCount = 0;
                                if (!string.IsNullOrEmpty(cart))
                                {
                                    var items = System.Text.Json.JsonSerializer.Deserialize<List<bai1.Models.CartItem>>(cart);
                                    cartCount = items?.Sum(i => i.Quantity) ?? 0;
                                }
                            }
                            @if (cartCount > 0)
                            {
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                    @cartCount
                                </span>
                            }
                        </a>

                        @{
                            if (User.Identity.IsAuthenticated)
                            {
                                // Lấy roles của user
                                var userRoles = User.Claims
                                    .Where(c => c.Type == System.Security.Claims.ClaimTypes.Role)
                                    .Select(c => c.Value)
                                    .ToList();
                                var isAdmin = userRoles.Contains("Admin");
                                var roleDisplay = isAdmin ? "Quản trị viên" : "Khách hàng";
                                
                                <div class="user-dropdown-wrapper">
                                    <button class="user-dropdown-toggle" id="userDropdownToggle">
                                        <div class="user-avatar @(isAdmin ? "admin-avatar" : "")">
                                            <i class="fa-solid fa-user"></i>
                                        </div>
                                        <div class="user-info">
                                            <span class="user-name">@User.Identity.Name</span>
                                            <span class="user-role">@roleDisplay</span>
                                        </div>
                                        <i class="fa-solid fa-chevron-down dropdown-arrow"></i>
                                    </button>
                                    <div class="user-dropdown-menu" id="userDropdownMenu">
                                        <div class="dropdown-header @(isAdmin ? "admin-header" : "")">
                                            <div class="header-avatar">
                                                <i class="fa-solid fa-user"></i>
                                            </div>
                                            <div class="header-info">
                                                <span class="header-name">@User.Identity.Name</span>
                                                <span class="header-email">@(User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "")</span>
                                                @if (isAdmin)
                                                {
                                                    <span class="badge bg-danger mt-1">Admin</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="dropdown-divider"></div>
                                        <ul class="dropdown-items">
                                            <li>
                                                <a asp-controller="MyOrder" asp-action="Index" class="dropdown-item">
                                                    <i class="fa-solid fa-box"></i>
                                                    <span>Đơn hàng của tôi</span>
                                                    <i class="fa-solid fa-chevron-right item-arrow"></i>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="#" class="dropdown-item">
                                                    <i class="fa-solid fa-heart"></i>
                                                    <span>Sách yêu thích</span>
                                                    <i class="fa-solid fa-chevron-right item-arrow"></i>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="#" class="dropdown-item">
                                                    <i class="fa-solid fa-user-pen"></i>
                                                    <span>Thông tin cá nhân</span>
                                                    <i class="fa-solid fa-chevron-right item-arrow"></i>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="#" class="dropdown-item">
                                                    <i class="fa-solid fa-map-location-dot"></i>
                                                    <span>Sổ địa chỉ</span>
                                                    <i class="fa-solid fa-chevron-right item-arrow"></i>
                                                </a>
                                            </li>
                                        </ul>
                                        @* Chỉ hiển thị menu Admin nếu user có role Admin *@
                                        @if (isAdmin)
                                        {
                                            <div class="dropdown-divider"></div>
                                            <div class="admin-section-title">
                                                <i class="fa-solid fa-shield-halved"></i> Quản trị
                                            </div>
                                            <ul class="dropdown-items">
                                                <li>
                                                    <a asp-controller="Book" asp-action="Index" class="dropdown-item admin-item">
                                                        <i class="fa-solid fa-book"></i>
                                                        <span>Quản lý sách</span>
                                                        <i class="fa-solid fa-chevron-right item-arrow"></i>
                                                    </a>
                                                </li>
                                                <li>
                                                    <a asp-controller="AdminOrder" asp-action="Index" class="dropdown-item admin-item">
                                                        <i class="fa-solid fa-clipboard-list"></i>
                                                        <span>Quản lý đơn hàng</span>
                                                        <i class="fa-solid fa-chevron-right item-arrow"></i>
                                                    </a>
                                                </li>
                                                <li>
                                                    <a asp-controller="AdminUser" asp-action="Index" class="dropdown-item admin-item">
                                                        <i class="fa-solid fa-users"></i>
                                                        <span>Quản lý người dùng</span>
                                                        <i class="fa-solid fa-chevron-right item-arrow"></i>
                                                    </a>
                                                </li>
                                                <li>
                                                    <a asp-controller="Report" asp-action="Index" class="dropdown-item admin-item">
                                                        <i class="fa-solid fa-chart-line"></i>
                                                        <span>Báo cáo doanh thu</span>
                                                        <i class="fa-solid fa-chevron-right item-arrow"></i>
                                                    </a>
                                                </li>
                                            </ul>
                                        }
                                        <div class="dropdown-divider"></div>
                                        <div class="dropdown-footer">
                                            <a asp-controller="Account" asp-action="Logout" class="logout-btn">
                                                <i class="fa-solid fa-right-from-bracket"></i>
                                                <span>Đăng xuất</span>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <button type="button" class="btn btn-primary" id="getStartedBtn" data-bs-toggle="modal" data-bs-target="#loginModal">
                                    <i class="fa-solid fa-user me-1"></i> Đăng nhập
                                </button>
                            }
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    @* Login Modal - đặt bên ngoài header để tránh z-index issues *@
    @if (!User.Identity.IsAuthenticated)
    {
        <div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div id="modalBody">
                    </div>
                </div>
            </div>
        </div>
    }

    @{
        var isAdminLayout = ViewData["IsAdminLayout"] as bool? ?? false;
    }
    
    @if (isAdminLayout)
    {
        <div class="flex-grow-1">
            <main role="main">
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <div class="container mt-4 flex-grow-1">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    }

    <footer class="main-footer mt-auto">
        <div class="container py-5">
            <div class="row gy-4">
                <div class="col-12 col-lg-4">
                    <div class="footer-title">
                        <span class="footer-title-bar"></span>
                        Thông tin liên hệ
                    </div>
                    <div class="footer-content">
                        <div class="company-name">Thành Long Book - Kho sách trực tuyến</div>
                        <div class="tax-id">MST: 4444888</div>
                        <div class="brand-tagline">Kết nối tri thức, lan tỏa văn hóa đọc.</div>
                        <div class="contact-item">
                            <i class="fa-solid fa-location-dot"></i>
                            <span>Địa chỉ: 180 Cao Lỗ, Quận 8, Thành Phố Hồ Chí Minh</span>
                        </div>
                        <div class="contact-item">
                            <i class="fa-solid fa-phone"></i>
                            <span>Hotline: 0767375429</span>
                        </div>
                        <div class="contact-item">
                            <i class="fa-solid fa-envelope"></i>
                            <span>Email: support@thanhlongbook.com</span>
                        </div>
                    </div>
                </div>

                <div class="col-6 col-md-4 col-lg-2">
                    <div class="footer-title">
                        <span class="footer-title-bar"></span>
                        Về chúng tôi
                    </div>
                    <ul class="footer-links">
                        <li><i class="fa-solid fa-circle"></i><a asp-controller="Home" asp-action="About">Giới thiệu</a></li>
                        <li><i class="fa-solid fa-circle"></i><a asp-controller="Book" asp-action="Index">Thư viện sách</a></li>
                        <li><i class="fa-solid fa-circle"></i><a asp-controller="Home" asp-action="Contact">Liên hệ</a></li>
                    </ul>
                </div>

                <div class="col-6 col-md-4 col-lg-2">
                    <div class="footer-title">
                        <span class="footer-title-bar"></span>
                        Hỗ trợ
                    </div>
                    <ul class="footer-links">
                        <li><i class="fa-solid fa-circle"></i><a href="#">Hướng dẫn mua hàng</a></li>
                        <li><i class="fa-solid fa-circle"></i><a asp-controller="TrackOrder" asp-action="Index">Tra cứu đơn hàng</a></li>
                        <li><i class="fa-solid fa-circle"></i><a href="#">Chính sách đổi trả</a></li>
                        <li><i class="fa-solid fa-circle"></i><a href="#">Bảo mật thông tin</a></li>
                    </ul>
                </div>

                <div class="col-12 col-md-4 col-lg-4">
                    <div class="footer-title">
                        <span class="footer-title-bar"></span>
                        Kết nối với chúng tôi
                    </div>
                    <div class="footer-social d-flex gap-3 mt-3">
                        <a href="#" class="social-icon"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="social-icon"><i class="fab fa-twitter"></i></a>
                        <a href="#" class="social-icon"><i class="fab fa-instagram"></i></a>
                        <a href="#" class="social-icon"><i class="fab fa-youtube"></i></a>
                    </div>
                </div>
            </div>
        </div>

        <div class="border-top py-3">
            <div class="container text-center">
                <span>&copy; @DateTime.Now.Year - Thành Long Book. All rights reserved.</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>

