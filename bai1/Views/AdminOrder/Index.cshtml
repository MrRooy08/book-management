@model List<bai1.Models.Order>

@{
    ViewData["Title"] = "Quản Lý Đơn Hàng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var statistics = ViewBag.Statistics as Dictionary<string, int> ?? new Dictionary<string, int>();
    var selectedStatus = ViewBag.SelectedStatus as string ?? "All";
}

<div class="mb-4">
    <h2 class="fw-bold">
        <i class="bi bi-box-seam"></i> Quản Lý Đơn Hàng
    </h2>
    <p class="text-muted">Xem và xử lý tất cả đơn hàng từ khách hàng</p>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Statistics Cards -->
<div class="row mb-4">
    <div class="col-md-2">
        <div class="card border-primary h-100">
            <div class="card-body text-center">
                <h6 class="text-muted">Chờ xác nhận</h6>
                <h3 class="text-primary">@statistics.GetValueOrDefault("Pending", 0)</h3>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card border-info h-100">
            <div class="card-body text-center">
                <h6 class="text-muted">Đã xác nhận</h6>
                <h3 class="text-info">@statistics.GetValueOrDefault("Confirmed", 0)</h3>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card border-warning h-100">
            <div class="card-body text-center">
                <h6 class="text-muted">Đang xử lý</h6>
                <h3 class="text-warning">@statistics.GetValueOrDefault("Processing", 0)</h3>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card border-purple h-100">
            <div class="card-body text-center">
                <h6 class="text-muted">Đang giao</h6>
                <h3 class="text-purple">@statistics.GetValueOrDefault("Shipping", 0)</h3>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card border-success h-100">
            <div class="card-body text-center">
                <h6 class="text-muted">Đã giao</h6>
                <h3 class="text-success">@statistics.GetValueOrDefault("Delivered", 0)</h3>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card border-danger h-100">
            <div class="card-body text-center">
                <h6 class="text-muted">Đã hủy</h6>
                <h3 class="text-danger">@statistics.GetValueOrDefault("Cancelled", 0)</h3>
            </div>
        </div>
    </div>
</div>

<!-- Filter Tabs -->
<ul class="nav nav-pills mb-3">
    <li class="nav-item">
        <a class="nav-link @(selectedStatus == "All" ? "active" : "")" 
           asp-action="Index" asp-route-status="All">
            Tất cả (@Model.Count)
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(selectedStatus == "Pending" ? "active" : "")" 
           asp-action="Index" asp-route-status="Pending">
            <i class="bi bi-clock"></i> Chờ xác nhận
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(selectedStatus == "Confirmed" ? "active" : "")" 
           asp-action="Index" asp-route-status="Confirmed">
            <i class="bi bi-check-circle"></i> Đã xác nhận
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(selectedStatus == "Processing" ? "active" : "")" 
           asp-action="Index" asp-route-status="Processing">
            <i class="bi bi-arrow-repeat"></i> Đang xử lý
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(selectedStatus == "Shipping" ? "active" : "")" 
           asp-action="Index" asp-route-status="Shipping">
            <i class="bi bi-truck"></i> Đang giao
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(selectedStatus == "Delivered" ? "active" : "")" 
           asp-action="Index" asp-route-status="Delivered">
            <i class="bi bi-check2-all"></i> Đã giao
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(selectedStatus == "Cancelled" ? "active" : "")" 
           asp-action="Index" asp-route-status="Cancelled">
            <i class="bi bi-x-circle"></i> Đã hủy
        </a>
    </li>
</ul>

<!-- Orders Table -->
<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Mã ĐH</th>
                        <th>Khách hàng</th>
                        <th>Ngày đặt</th>
                        <th>Tổng tiền</th>
                        <th>Thanh toán</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <i class="bi bi-inbox" style="font-size: 3rem; color: #ccc;"></i>
                                <p class="text-muted mt-3">Không có đơn hàng nào</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td class="fw-bold">#@order.Id</td>
                                <td>
                                    <div>@order.CustomerName</div>
                                    <small class="text-muted">@order.Phone</small>
                                </td>
                                <td>@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="fw-bold text-primary">@order.TotalAmount.ToString("N0") ₫</td>
                                <td>
                                    @if (order.PaymentMethod == "COD")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-cash"></i> COD
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info">
                                            <i class="bi bi-credit-card"></i> VNPay
                                        </span>
                                    }
                                    <br />
                                    @if (order.PaymentStatus == "Paid")
                                    {
                                        <small class="badge bg-success mt-1">Đã thanh toán</small>
                                    }
                                    else
                                    {
                                        <small class="badge bg-secondary mt-1">Chưa thanh toán</small>
                                    }
                                </td>
                                <td>
                                    @switch (order.OrderStatus)
                                    {
                                        case "Pending":
                                            <span class="badge bg-primary">
                                                <i class="bi bi-clock"></i> Chờ xác nhận
                                            </span>
                                            break;
                                        case "Confirmed":
                                            <span class="badge bg-info">
                                                <i class="bi bi-check-circle"></i> Đã xác nhận
                                            </span>
                                            break;
                                        case "Processing":
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-arrow-repeat"></i> Đang chuẩn bị
                                            </span>
                                            break;
                                        case "Shipping":
                                            <span class="badge bg-purple">
                                                <i class="bi bi-truck"></i> Đang giao
                                            </span>
                                            break;
                                        case "Delivered":
                                            <span class="badge bg-success">
                                                <i class="bi bi-check2-all"></i> Đã giao
                                            </span>
                                            break;
                                        case "Cancelled":
                                            <span class="badge bg-danger">
                                                <i class="bi bi-x-circle"></i> Đã hủy
                                            </span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@order.Id" 
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i> Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .border-purple { border-color: #6f42c1 !important; }
        .text-purple { color: #6f42c1 !important; }
        .bg-purple { background-color: #6f42c1 !important; }
        .card { box-shadow: 0 0.125rem 0.25rem rgba(0,0,0,0.075); }
        .table th { font-weight: 600; }
    </style>
}
