@model bai1.Models.Order

@{
    ViewData["Title"] = "Chi Tiết Đơn Hàng #" + Model.Id;
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
    <h2 class="d-inline ms-3">Chi Tiết Đơn Hàng #@Model.Id</h2>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <!-- Order Status Timeline -->
    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-clock-history"></i> Trạng Thái Đơn Hàng</h5>
            </div>
            <div class="card-body">
                <div class="order-timeline">
                    <div class="timeline-item @(Model.OrderStatus == "Pending" ? "active" : "completed")">
                        <div class="timeline-marker">
                            <i class="bi bi-clock"></i>
                        </div>
                        <div class="timeline-content">
                            <h6>Chờ xác nhận</h6>
                            <small>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                    </div>

                    <div class="timeline-item @(Model.OrderStatus == "Confirmed" ? "active" : (new[] {"Processing", "Shipping", "Delivered"}.Contains(Model.OrderStatus) ? "completed" : ""))">
                        <div class="timeline-marker">
                            <i class="bi bi-check-circle"></i>
                        </div>
                        <div class="timeline-content">
                            <h6>Đã xác nhận</h6>
                        </div>
                    </div>

                    <div class="timeline-item @(Model.OrderStatus == "Processing" ? "active" : (new[] {"Shipping", "Delivered"}.Contains(Model.OrderStatus) ? "completed" : ""))">
                        <div class="timeline-marker">
                            <i class="bi bi-box-seam"></i>
                        </div>
                        <div class="timeline-content">
                            <h6>Đang chuẩn bị hàng</h6>
                        </div>
                    </div>

                    <div class="timeline-item @(Model.OrderStatus == "Shipping" ? "active" : (Model.OrderStatus == "Delivered" ? "completed" : ""))">
                        <div class="timeline-marker">
                            <i class="bi bi-truck"></i>
                        </div>
                        <div class="timeline-content">
                            <h6>Đang giao hàng</h6>
                        </div>
                    </div>

                    <div class="timeline-item @(Model.OrderStatus == "Delivered" ? "completed" : "")">
                        <div class="timeline-marker">
                            <i class="bi bi-check2-all"></i>
                        </div>
                        <div class="timeline-content">
                            <h6>Đã giao hàng</h6>
                            @if (Model.DeliveredAt != null)
                            {
                                <small>@Model.DeliveredAt.Value.ToString("dd/MM/yyyy HH:mm")</small>
                            }
                        </div>
                    </div>

                    @if (Model.OrderStatus == "Cancelled")
                    {
                        <div class="timeline-item cancelled">
                            <div class="timeline-marker">
                                <i class="bi bi-x-circle"></i>
                            </div>
                            <div class="timeline-content">
                                <h6>Đã hủy</h6>
                                <small>@Model.CancelledAt?.ToString("dd/MM/yyyy HH:mm")</small>
                                @if (!string.IsNullOrEmpty(Model.CancelReason))
                                {
                                    <p class="text-danger mb-0"><small>Lý do: @Model.CancelReason</small></p>
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- Action Buttons -->
                @if (Model.OrderStatus != "Cancelled" && Model.OrderStatus != "Delivered")
                {
                    <div class="mt-4">
                        <h6>Cập nhật trạng thái:</h6>
                        <div class="btn-group flex-wrap" role="group">
                            @if (Model.OrderStatus == "Pending")
                            {
                                <form asp-action="ConfirmOrder" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <button type="submit" class="btn btn-success" onclick="return confirm('Xác nhận đơn hàng này?')">
                                        <i class="bi bi-check-circle"></i> Xác nhận đơn hàng
                                    </button>
                                </form>
                            }
                            @if (Model.OrderStatus == "Confirmed")
                            {
                                <form asp-action="UpdateStatus" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <input type="hidden" name="status" value="Processing" />
                                    <button type="submit" class="btn btn-warning">
                                        <i class="bi bi-box-seam"></i> Bắt đầu chuẩn bị
                                    </button>
                                </form>
                            }
                            @if (Model.OrderStatus == "Processing")
                            {
                                <form asp-action="UpdateStatus" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <input type="hidden" name="status" value="Shipping" />
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-truck"></i> Bắt đầu giao hàng
                                    </button>
                                </form>
                            }
                            @if (Model.OrderStatus == "Shipping")
                            {
                                <form asp-action="UpdateStatus" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <input type="hidden" name="status" value="Delivered" />
                                    <button type="submit" class="btn btn-success">
                                        <i class="bi bi-check2-all"></i> Xác nhận đã giao
                                    </button>
                                </form>
                            }

                            <button type="button" class="btn btn-danger ms-2" data-bs-toggle="modal" data-bs-target="#cancelModal">
                                <i class="bi bi-x-circle"></i> Hủy đơn hàng
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Order Items -->
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-cart"></i> Chi Tiết Sản Phẩm</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Sản phẩm</th>
                                <th>Đơn giá</th>
                                <th>Số lượng</th>
                                <th>Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderDetails)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            @if (item.Book?.Images?.Any() == true)
                                            {
                                                <img src="~/@item.Book.Images.First().ImageUrl" 
                                                     alt="@item.BookTitle" 
                                                     class="me-3" 
                                                     style="width: 50px; height: 70px; object-fit: cover;" />
                                            }
                                            <span>@item.BookTitle</span>
                                        </div>
                                    </td>
                                    <td>@item.Price.ToString("N0") ₫</td>
                                    <td>@item.Quantity</td>
                                    <td class="fw-bold">@item.Subtotal.ToString("N0") ₫</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="text-end fw-bold">Tổng cộng:</td>
                                <td class="fw-bold text-primary fs-5">@Model.TotalAmount.ToString("N0") ₫</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Order Info -->
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-person"></i> Thông Tin Khách Hàng</h5>
            </div>
            <div class="card-body">
                <p><strong>Tên:</strong> @Model.CustomerName</p>
                <p><strong>Email:</strong> @Model.Email</p>
                <p><strong>SĐT:</strong> @Model.Phone</p>
                <p><strong>Địa chỉ:</strong><br />@Model.ShippingAddress</p>
                @if (!string.IsNullOrEmpty(Model.Note))
                {
                    <p><strong>Ghi chú:</strong><br />@Model.Note</p>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-credit-card"></i> Thông Tin Thanh Toán</h5>
            </div>
            <div class="card-body">
                <p>
                    <strong>Phương thức:</strong>
                    @if (Model.PaymentMethod == "COD")
                    {
                        <span class="badge bg-warning text-dark">
                            <i class="bi bi-cash"></i> Thanh toán khi nhận hàng
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-info">
                            <i class="bi bi-credit-card"></i> VNPay
                        </span>
                    }
                </p>
                <p>
                    <strong>Trạng thái:</strong>
                    @if (Model.PaymentStatus == "Paid")
                    {
                        <span class="badge bg-success">Đã thanh toán</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Chưa thanh toán</span>
                    }
                </p>
                @if (!string.IsNullOrEmpty(Model.VnpayTransactionId))
                {
                    <p><strong>Mã GD VNPay:</strong><br />@Model.VnpayTransactionId</p>
                }
                @if (Model.PaidAt != null)
                {
                    <p><strong>Thanh toán lúc:</strong><br />@Model.PaidAt.Value.ToString("dd/MM/yyyy HH:mm")</p>
                }
            </div>
        </div>
    </div>
</div>

<!-- Cancel Modal -->
<div class="modal fade" id="cancelModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CancelOrder" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="modal-header">
                    <h5 class="modal-title">Hủy Đơn Hàng</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Lý do hủy đơn <span class="text-danger">*</span></label>
                        <textarea name="reason" class="form-control" rows="3" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-danger">Xác nhận hủy</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .order-timeline {
            position: relative;
            padding-left: 50px;
        }

        .timeline-item {
            position: relative;
            padding-bottom: 30px;
        }

        .timeline-item::before {
            content: '';
            position: absolute;
            left: -35px;
            top: 30px;
            width: 2px;
            height: calc(100% - 10px);
            background: #ddd;
        }

        .timeline-item:last-child::before {
            display: none;
        }

        .timeline-marker {
            position: absolute;
            left: -47px;
            top: 0;
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: #ddd;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
        }

        .timeline-item.active .timeline-marker {
            background: #ffc107;
            animation: pulse 1.5s infinite;
        }

        .timeline-item.completed .timeline-marker {
            background: #28a745;
        }

        .timeline-item.cancelled .timeline-marker {
            background: #dc3545;
        }

        @@keyframes pulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(255, 193, 7, 0.7); }
            50% { box-shadow: 0 0 0 10px rgba(255, 193, 7, 0); }
        }

        .timeline-content h6 {
            margin-bottom: 5px;
            font-weight: 600;
        }

        .timeline-item.active .timeline-content h6 {
            color: #ffc107;
        }

        .timeline-item.completed .timeline-content h6 {
            color: #28a745;
        }
    </style>
}
