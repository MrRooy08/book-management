@model List<bai1.Models.User>

@{
    ViewData["Title"] = "Qu?n Lý Ng??i Dùng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    
    var statistics = ViewBag.Statistics as bai1.Services.UserStatistics;
    var roles = ViewBag.Roles as List<bai1.Models.Role>;
    var search = ViewBag.Search as string;
    var status = ViewBag.Status as string;
    var role = ViewBag.Role as string;
    var isVip = ViewBag.IsVip as bool?;
    var page = (int)ViewBag.Page;
    var pageSize = (int)ViewBag.PageSize;
    var totalCount = (int)ViewBag.TotalCount;
    var totalPages = (int)ViewBag.TotalPages;
}

<div class="mb-4">
    <h2 class="fw-bold">
        <i class="bi bi-people"></i> Qu?n Lý Ng??i Dùng
    </h2>
    <p class="text-muted">Xem và qu?n lý tài kho?n ng??i dùng</p>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Statistics Cards -->
@if (statistics != null)
{
    <div class="row mb-4">
        <div class="col-md-2">
            <div class="card bg-primary text-white h-100">
                <div class="card-body text-center">
                    <i class="bi bi-people" style="font-size: 1.5rem;"></i>
                    <h3 class="mb-0 mt-2">@statistics.TotalUsers</h3>
                    <small>T?ng ng??i dùng</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-success text-white h-100">
                <div class="card-body text-center">
                    <i class="bi bi-person-check" style="font-size: 1.5rem;"></i>
                    <h3 class="mb-0 mt-2">@statistics.ActiveUsers</h3>
                    <small>?ang ho?t ??ng</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-danger text-white h-100">
                <div class="card-body text-center">
                    <i class="bi bi-person-x" style="font-size: 1.5rem;"></i>
                    <h3 class="mb-0 mt-2">@statistics.InactiveUsers</h3>
                    <small>B? khóa</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-warning text-dark h-100">
                <div class="card-body text-center">
                    <i class="bi bi-star-fill" style="font-size: 1.5rem;"></i>
                    <h3 class="mb-0 mt-2">@statistics.VipUsers</h3>
                    <small>Khách VIP</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-info text-white h-100">
                <div class="card-body text-center">
                    <i class="bi bi-shield-check" style="font-size: 1.5rem;"></i>
                    <h3 class="mb-0 mt-2">@statistics.AdminUsers</h3>
                    <small>Qu?n tr? viên</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-secondary text-white h-100">
                <div class="card-body text-center">
                    <i class="bi bi-person-plus" style="font-size: 1.5rem;"></i>
                    <h3 class="mb-0 mt-2">@statistics.NewUsersThisMonth</h3>
                    <small>M?i tháng này</small>
                </div>
            </div>
        </div>
    </div>
}

<!-- Filter Section -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Tìm ki?m</label>
                <input type="text" name="search" class="form-control" placeholder="Tên, email, S?T..." value="@search" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Tr?ng thái</label>
                <select name="status" class="form-select">
                    <option value="">T?t c?</option>
                    <option value="active" selected="@(status == "active")">Ho?t ??ng</option>
                    <option value="inactive" selected="@(status == "inactive")">B? khóa</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Vai trò</label>
                <select name="role" class="form-select">
                    <option value="">T?t c?</option>
                    @if (roles != null)
                    {
                        @foreach (var r in roles)
                        {
                            <option value="@r.RoleName" selected="@(role == r.RoleName)">@r.RoleName</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">VIP</label>
                <select name="isVip" class="form-select">
                    <option value="">T?t c?</option>
                    <option value="true" selected="@(isVip == true)">Là VIP</option>
                    <option value="false" selected="@(isVip == false)">Không ph?i VIP</option>
                </select>
            </div>
            <div class="col-md-1">
                <label class="form-label">Hi?n th?</label>
                <select name="pageSize" class="form-select">
                    <option value="10" selected="@(pageSize == 10)">10</option>
                    <option value="25" selected="@(pageSize == 25)">25</option>
                    <option value="50" selected="@(pageSize == 50)">50</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-funnel"></i> L?c
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Results Info -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="text-muted">
        Hi?n th? <strong>@(Model.Count > 0 ? ((page - 1) * pageSize) + 1 : 0)</strong> - 
        <strong>@Math.Min(page * pageSize, totalCount)</strong> 
        trong t?ng s? <strong>@totalCount</strong> ng??i dùng
    </span>
</div>

<!-- Users Table -->
<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Ng??i dùng</th>
                        <th>Liên h?</th>
                        <th class="text-center">Vai trò</th>
                        <th class="text-center">Tr?ng thái</th>
                        <th class="text-center">VIP</th>
                        <th class="text-end">Chi tiêu</th>
                        <th class="text-center">??n hàng</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5">
                                <i class="bi bi-inbox" style="font-size: 3rem; color: #ccc;"></i>
                                <p class="text-muted mt-3">Không tìm th?y ng??i dùng nào</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var user in Model)
                        {
                            var userIsAdmin = user.Roles.Any(r => r.RoleName == "Admin");
                            <tr class="@(!user.IsActive ? "table-secondary" : "")">
                                <td>@user.Id</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="user-avatar-sm me-2 @(userIsAdmin ? "admin-avatar" : "") @(user.IsVip ? "vip-avatar" : "")">
                                            @if (!string.IsNullOrEmpty(user.Avatar))
                                            {
                                                <img src="~/@user.Avatar" alt="@user.Name" class="rounded-circle" style="width: 36px; height: 36px; object-fit: cover;" />
                                            }
                                            else
                                            {
                                                <i class="bi bi-person-circle" style="font-size: 36px; color: #6c757d;"></i>
                                            }
                                        </div>
                                        <div>
                                            <strong>@(user.Name ?? "Ch?a ??t tên")</strong>
                                            @if (user.IsVip)
                                            {
                                                <span class="badge bg-warning text-dark ms-1"><i class="bi bi-star-fill"></i></span>
                                            }
                                            <br />
                                            <small class="text-muted">Tham gia: @user.CreatedAt.ToString("dd/MM/yyyy")</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div><i class="bi bi-envelope me-1"></i> @user.Email</div>
                                    @if (!string.IsNullOrEmpty(user.Phone))
                                    {
                                        <div><i class="bi bi-telephone me-1"></i> @user.Phone</div>
                                    }
                                </td>
                                <td class="text-center">
                                    @foreach (var userRole in user.Roles)
                                    {
                                        <span class="badge @(userRole.RoleName == "Admin" ? "bg-danger" : "bg-secondary")">
                                            @userRole.RoleName
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle"></i> Ho?t ??ng
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            <i class="bi bi-x-circle"></i> B? khóa
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (user.IsVip)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-star-fill"></i> VIP
                                        </span>
                                        @if (user.VipEndDate.HasValue)
                                        {
                                            <br />
                                            <small class="text-muted">??n @user.VipEndDate.Value.ToString("dd/MM/yyyy")</small>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <strong class="text-primary">@user.TotalSpent.ToString("N0") ?</strong>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-info">@user.TotalOrders</span>
                                </td>
                                <td class="text-center">
                                    <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary" title="Xem chi ti?t">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Pagination -->
@if (totalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(page == 1 ? "disabled" : "")">
                <a class="page-link" 
                   asp-action="Index" 
                   asp-route-search="@search"
                   asp-route-status="@status"
                   asp-route-role="@role"
                   asp-route-isVip="@isVip"
                   asp-route-pageSize="@pageSize"
                   asp-route-page="@(page - 1)">
                    <i class="bi bi-chevron-left"></i>
                </a>
            </li>

            @for (int i = Math.Max(1, page - 2); i <= Math.Min(totalPages, page + 2); i++)
            {
                <li class="page-item @(i == page ? "active" : "")">
                    <a class="page-link" 
                       asp-action="Index"
                       asp-route-search="@search"
                       asp-route-status="@status"
                       asp-route-role="@role"
                       asp-route-isVip="@isVip"
                       asp-route-pageSize="@pageSize"
                       asp-route-page="@i">@i</a>
                </li>
            }

            <li class="page-item @(page == totalPages ? "disabled" : "")">
                <a class="page-link" 
                   asp-action="Index"
                   asp-route-search="@search"
                   asp-route-status="@status"
                   asp-route-role="@role"
                   asp-route-isVip="@isVip"
                   asp-route-pageSize="@pageSize"
                   asp-route-page="@(page + 1)">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
}

@section Styles {
    <style>
        .card { box-shadow: 0 0.125rem 0.25rem rgba(0,0,0,0.075); }
        .table th { font-weight: 600; font-size: 0.875rem; }
        
        .user-avatar-sm {
            position: relative;
        }
        
        .user-avatar-sm.vip-avatar::after {
            content: '?';
            position: absolute;
            bottom: -2px;
            right: -2px;
            font-size: 12px;
        }
        
        .user-avatar-sm.admin-avatar::after {
            content: '???';
            position: absolute;
            bottom: -2px;
            right: -2px;
            font-size: 12px;
        }
    </style>
}
