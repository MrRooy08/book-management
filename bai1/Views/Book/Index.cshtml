<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/bookAdmin.js" asp-append-version="true"></script>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#ParentCategoryId').change(function () {
                var parentId = $(this).val();
                var subSelect = $('#SubCategoryId');

                if (!parentId) {
                    subSelect.empty().append('<option value="">-- Chọn danh mục cha trước --</option>');
                    subSelect.prop('disabled', true);
                    return;
                }

                $.ajax({
                    url: '/Book/GetSubCategories',
                    type: 'GET',
                    data: { parentId: parentId },
                    success: function (data) {
                        subSelect.empty();
                        subSelect.append('<option value="">-- Chọn danh mục con --</option>');
                        $.each(data, function (index, item) {
                            subSelect.append('<option value="' + item.id + '">' + item.name + '</option>');
                        });
                        subSelect.prop('disabled', false);
                    },
                    error: function () {
                        alert('Lỗi khi tải danh mục con!');
                    }
                });
            });

            // Search book
            $('#searchBook').on('keyup', function() {
                var value = $(this).val().toLowerCase();
                filterBooks();
            });

            // Filter by stock status
            $('#filterStock').on('change', function() {
                filterBooks();
            });

            function filterBooks() {
                var searchValue = $('#searchBook').val().toLowerCase();
                var stockFilter = $('#filterStock').val();
                
                $('#bookTable tbody tr').each(function() {
                    var textMatch = $(this).text().toLowerCase().indexOf(searchValue) > -1;
                    var stockMatch = stockFilter === 'all' || $(this).data('stock') === stockFilter;
                    
                    $(this).toggle(textMatch && stockMatch);
                });
            }

            // Hàm parse dimension từ string (hỗ trợ format: 14.5, 14,5)
            function parseDimension(dimensionString) {
                if (!dimensionString) return 0;
                
                var cleaned = dimensionString.toString().trim()
                    .replace(/\s/g, '')
                    .replace(',', '.'); // Thay dấu phẩy thành dấu chấm
                
                return parseFloat(cleaned) || 0;
            }

            // Cho phép nhập số, dấu chấm và dấu phẩy cho dimension
            $('.dimension-input').on('keypress', function(e) {
                var charCode = e.which;
                var inputVal = $(this).val();
                
                // Cho phép: số (48-57), dấu chấm (46), dấu phẩy (44)
                if (charCode !== 46 && charCode !== 44 && charCode > 31 && (charCode < 48 || charCode > 57)) {
                    e.preventDefault();
                    return;
                }
                
                // Chỉ cho phép 1 dấu thập phân (chấm hoặc phẩy)
                if ((charCode === 46 || charCode === 44) && (inputVal.indexOf('.') !== -1 || inputVal.indexOf(',') !== -1)) {
                    e.preventDefault();
                }
            });

            // Validate và chuẩn hóa dimension khi blur
            $('.dimension-input').on('blur', function() {
                var value = parseDimension($(this).val());
                if (value > 0) {
                    // Hiển thị với dấu chấm làm thập phân
                    $(this).val(value.toString());
                } else if ($(this).val() !== '') {
                    $(this).val('');
                }
            });

            // Hàm parse giá từ string (hỗ trợ format: 150000, 150.000, 150,000)
            function parsePrice(priceString) {
                if (!priceString) return 0;
                
                var cleaned = priceString.toString().trim()
                    .replace(/₫/g, '')
                    .replace(/VND/gi, '')
                    .replace(/\s/g, '');
                
                // Xử lý format Việt Nam (150.000)
                if (cleaned.indexOf('.') !== -1 && cleaned.indexOf(',') === -1) {
                    cleaned = cleaned.replace(/\./g, '');
                }
                // Nếu có cả dấu phẩy và dấu chấm
                else if (cleaned.indexOf(',') !== -1 && cleaned.indexOf('.') !== -1) {
                    // Kiểm tra định dạng: 150,000.50
                    var parts = cleaned.split(',');
                    if (parts.length === 2 && parts[1].length <= 2) {
                        cleaned = cleaned.replace(/,/g, '').replace('.', ',');
                    } else {
                        cleaned = cleaned.replace(/\./g, '').replace(',', '.');
                    }
                }
                // Nếu chỉ có dấu phẩy
                else if (cleaned.indexOf(',') !== -1) {
                    var parts = cleaned.split(',');
                    if (parts.length === 2 && parts[1].length === 3) {
                        cleaned = cleaned.replace(/,/g, '');
                    } else {
                        cleaned = cleaned.replace(',', '.');
                    }
                }
                
                return parseFloat(cleaned) || 0;
            }

            // Hàm format số thành định dạng tiền tệ VN
            function formatPrice(number) {
                if (!number || isNaN(number)) return '';
                return number.toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.');
            }

            // Auto-format khi nhập giá
            $('.price-input').on('blur', function() {
                var value = parsePrice($(this).val());
                if (value > 0) {
                    $(this).val(formatPrice(value));
                }
            });

            // Cho phép nhập số và dấu chấm, dấu phẩy
            $('.price-input').on('keypress', function(e) {
                var charCode = e.which;
                // Cho phép: số (48-57), dấu chấm (46), dấu phẩy (44), Backspace, Delete, Tab, Escape, Enter
                if (charCode !== 46 && charCode !== 44 && charCode > 31 && (charCode < 48 || charCode > 57)) {
                    e.preventDefault();
                }
            });

            // Validate giá và tính % giảm giá
            function validateAndCalculateDiscount() {
                var listPrice = parsePrice($('#listprice').val());
                var salePrice = parsePrice($('#saleprice').val());
                var costPrice = parsePrice($('#costprice').val());
                var priceError = $('#priceError');
                var priceErrorMessage = $('#priceErrorMessage');
                var discountPercent = $('#discountPercent');
                
                var hasError = false;
                var errorMessages = [];
                
                // Kiểm tra giá niêm yết >= giá bán
                if (listPrice > 0 && salePrice > 0 && salePrice > listPrice) {
                    errorMessages.push('Giá bán không được cao hơn giá niêm yết!');
                    hasError = true;
                }
                
                // Kiểm tra giá bán >= giá nhập (để có lợi nhuận)
                if (salePrice > 0 && costPrice > 0 && salePrice < costPrice) {
                    errorMessages.push('Cảnh báo: Giá bán thấp hơn giá nhập (lỗ vốn)!');
                }
                
                // Hiển thị lỗi
                if (errorMessages.length > 0) {
                    priceErrorMessage.html(errorMessages.join('<br>'));
                    priceError.removeClass('d-none');
                } else {
                    priceError.addClass('d-none');
                }
                
                // Tính % giảm giá
                if (listPrice > 0 && salePrice > 0 && listPrice >= salePrice) {
                    var discount = ((listPrice - salePrice) / listPrice * 100).toFixed(0);
                    discountPercent.text('-' + discount + '%');
                    if (discount > 0) {
                        discountPercent.removeClass('bg-secondary').addClass('bg-success');
                    } else {
                        discountPercent.removeClass('bg-success').addClass('bg-secondary');
                        discountPercent.text('0%');
                    }
                } else {
                    discountPercent.text('0%');
                    discountPercent.removeClass('bg-success').addClass('bg-secondary');
                }
                
                return !hasError;
            }
            
            // Gắn sự kiện cho các input giá
            $('#listprice, #saleprice, #costprice').on('input blur', validateAndCalculateDiscount);
        });
    </script>
}