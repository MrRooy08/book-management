@model IEnumerable<bai1.Models.Book>

@{
    ViewData["Title"] = "Quản Lý Sách";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    
    // Tính toán thống kê từ dữ liệu thực
    var totalBooks = Model.Count();
    var inStockBooks = Model.Count(b => b.Inventory != null && b.Inventory.Quantity > 0);
    var lowStockBooks = Model.Count(b => b.Inventory != null && b.Inventory.Quantity > 0 && b.Inventory.Quantity <= 10);
    var outOfStockBooks = Model.Count(b => b.Inventory == null || b.Inventory.Quantity == 0);
    
    // Tính tổng giá trị kho hàng
    var totalInventoryValue = Model.Sum(b => (b.Inventory?.Quantity ?? 0) * b.CostPrice);
    var totalSaleValue = Model.Sum(b => (b.Inventory?.Quantity ?? 0) * b.SalePrice);
}

<div class="mb-4">
    <h2 class="fw-bold">
        <i class="bi bi-book"></i> Quản Lý Sách
    </h2>
    <p class="text-muted">Thêm, sửa, xóa và quản lý kho sách</p>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Tab Navigation -->
<ul class="nav nav-tabs mb-4" id="bookTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="dashboard-tab" data-bs-toggle="tab" data-bs-target="#dashboard" type="button" role="tab">
            <i class="bi bi-grid-1x2"></i> Tổng quan
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="book-tab" data-bs-toggle="tab" data-bs-target="#book" type="button" role="tab">
            <i class="bi bi-plus-circle"></i> Thêm sách mới
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="list-tab" data-bs-toggle="tab" data-bs-target="#list" type="button" role="tab">
            <i class="bi bi-list"></i> Danh sách sách (@totalBooks)
        </button>
    </li>
</ul>

<div class="tab-content" id="bookTabsContent">
    <!-- Dashboard Tab -->
    <div class="tab-pane fade show active" id="dashboard" role="tabpanel">
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card bg-primary text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <h6>Tổng số sách</h6>
                                <h2>@totalBooks</h2>
                            </div>
                            <i class="bi bi-book" style="font-size: 2.5rem; opacity: 0.5;"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-success text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <h6>Còn hàng</h6>
                                <h2>@inStockBooks</h2>
                            </div>
                            <i class="bi bi-check-circle" style="font-size: 2.5rem; opacity: 0.5;"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-warning text-dark">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <h6>Sắp hết hàng</h6>
                                <h2>@lowStockBooks</h2>
                            </div>
                            <i class="bi bi-exclamation-triangle" style="font-size: 2.5rem; opacity: 0.5;"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-danger text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <h6>Hết hàng</h6>
                                <h2>@outOfStockBooks</h2>
                            </div>
                            <i class="bi bi-x-circle" style="font-size: 2.5rem; opacity: 0.5;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Thống kê giá trị kho -->
        <div class="row mb-4">
            <div class="col-md-6">
                <div class="card border-info">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted">Giá trị kho (theo giá vốn)</h6>
                                <h3 class="text-info">@totalInventoryValue.ToString("N0") ₫</h3>
                            </div>
                            <i class="bi bi-box-seam text-info" style="font-size: 2rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card border-success">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted">Giá trị kho (theo giá bán)</h6>
                                <h3 class="text-success">@totalSaleValue.ToString("N0") ₫</h3>
                            </div>
                            <i class="bi bi-currency-dollar text-success" style="font-size: 2rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-clock-history"></i> Sách mới thêm gần đây</h5>
                    </div>
                    <div class="card-body">
                        @if (Model.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Sách</th>
                                            <th>Tác giả</th>
                                            <th>Ngày XB</th>
                                            <th class="text-end">Giá bán</th>
                                            <th class="text-center">Tồn kho</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var book in Model.OrderByDescending(b => b.Id).Take(5))
                                        {
                                            var quantity = book.Inventory?.Quantity ?? 0;
                                            var badgeClass = quantity > 10 ? "bg-success" : quantity > 0 ? "bg-warning" : "bg-danger";
                                            <tr>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        @if (book.Images?.Any() == true)
                                                        {
                                                            <img src="~/@book.Images.First().ImageUrl" alt="@book.Title" 
                                                                 class="me-2 rounded" style="width: 40px; height: 55px; object-fit: cover;" />
                                                        }
                                                        else
                                                        {
                                                            <div class="me-2 bg-light d-flex align-items-center justify-content-center rounded" 
                                                                 style="width: 40px; height: 55px;">
                                                                <i class="bi bi-book text-muted"></i>
                                                            </div>
                                                        }
                                                        <a asp-action="Details" asp-route-id="@book.Id" class="text-decoration-none">
                                                            @book.Title
                                                        </a>
                                                    </div>
                                                </td>
                                                <td>@(book.Authors?.FirstOrDefault()?.Author?.Name ?? "Chưa có")</td>
                                                <td>
                                                    <small class="text-muted">@book.PublishDate.ToString("dd/MM/yyyy")</small>
                                                </td>
                                                <td class="text-end">@book.SalePrice.ToString("N0") ₫</td>
                                                <td class="text-center">
                                                    <span class="badge @badgeClass">
                                                        @quantity
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                                <p class="text-muted mt-2">Chưa có sách nào trong hệ thống</p>
                                <button class="btn btn-primary" onclick="document.getElementById('book-tab').click()">
                                    <i class="bi bi-plus-circle"></i> Thêm sách đầu tiên
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card mb-3">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-lightning"></i> Thao tác nhanh</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <button class="btn btn-primary" onclick="document.getElementById('book-tab').click()">
                                <i class="bi bi-plus-circle"></i> Thêm sách mới
                            </button>
                            <a href="/AdminOrder" class="btn btn-outline-primary">
                                <i class="bi bi-box-seam"></i> Quản lý đơn hàng
                            </a>
                            <a href="/Report" class="btn btn-outline-success">
                                <i class="bi bi-graph-up"></i> Xem báo cáo
                            </a>
                        </div>
                    </div>
                </div>
                
                <!-- Sách sắp hết hàng -->
                @if (lowStockBooks > 0)
                {
                    <div class="card border-warning">
                        <div class="card-header bg-warning text-dark">
                            <h6 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Cảnh báo tồn kho</h6>
                        </div>
                        <div class="card-body p-0">
                            <ul class="list-group list-group-flush">
                                @foreach (var book in Model.Where(b => b.Inventory != null && b.Inventory.Quantity > 0 && b.Inventory.Quantity <= 10).Take(5))
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <small class="text-truncate" style="max-width: 150px;">@book.Title</small>
                                        <span class="badge bg-warning text-dark">@book.Inventory?.Quantity còn</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Add Book Tab -->
    <div class="tab-pane fade" id="book" role="tabpanel">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-plus-circle"></i> Thêm Sách Mới</h5>
            </div>
            <div class="card-body">
                <form method="post" action="/Book/AddBook" enctype="multipart/form-data">
                    <!-- Step Indicator -->
                    <div class="step-indicator d-flex mb-4">
                        <div class="step-item active" id="indicator-1">1. Thông tin sách</div>
                        <div class="step-item" id="indicator-2">2. Giá & Tồn kho</div>
                        <div class="step-item" id="indicator-3">3. Xác nhận</div>
                    </div>

                    <!-- Step 1 -->
                    <div class="step active" id="step-1">
                        <h5 class="mb-4">Bước 1: Thông tin sách</h5>
                        
                        <div class="row">
                            <div class="col-md-4">
                                <div class="upload-container">
                                    <label class="form-label">Ảnh bìa sách</label>
                                    <div class="upload-zone">
                                        <div class="upload-preview" id="preview-area"></div>
                                        <input type="file" id="book-cover" name="Image" class="upload-zone__input" accept="image/*" hidden>
                                        <label for="book-cover" class="upload-zone__label">
                                            <div class="upload-zone__icon">📚</div>
                                            <p class="upload-zone__text">
                                                <strong id="text-upload">Click để upload</strong>
                                            </p>
                                            <p class="upload-zone__hint">PNG, JPG (Tối đa 800x1200px)</p>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-8">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="ISBN" class="form-label">ISBN <span class="text-danger">*</span></label>
                                        <input type="text" id="ISBN" name="ISBN" maxlength="13" class="form-control required-field" placeholder="VD: 9780747532743" />
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label for="publishDate" class="form-label">Ngày xuất bản <span class="text-danger">*</span></label>
                                        <input type="date" id="publishDate" class="form-control required-field" name="PublishDate" />
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label for="productTitle" class="form-label">Tên sách <span class="text-danger">*</span></label>
                                    <input type="text" id="productTitle" name="Title" class="form-control required-field" placeholder="Nhập tên sách..." />
                                </div>
                                <div class="mb-3">
                                    <label for="authors" class="form-label">Tác giả <span class="text-danger">*</span></label>
                                    <input type="text" id="AuthorSearch" class="form-control" placeholder="Nhập tên tác giả..." />
                                    <div id="AuthorSuggestions" class="list-group w-100" style="z-index: 1; display: none;"></div>
                                    <input type="hidden" id="AuthorIds" name="AuthorIds" class="required-field" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Dịch giả</label>
                                    <input type="text" id="TranslatorSearch" class="form-control" placeholder="Tìm dịch giả..." />
                                    <div id="TranslatorSuggestions" class="list-group w-100" style="z-index: 10; display: none;"></div>
                                    <div id="SelectedTranslators" class="mt-2"></div>
                                    <input type="hidden" id="TranslatorData" name="TranslatorData" />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Nhà xuất bản</label>
                                <select name="PublisherId" class="form-control">
                                    <option value="">-- Chọn NXB --</option>
                                    @if (ViewBag.PublisherList != null)
                                    {
                                        foreach (var item in (IEnumerable<SelectListItem>)ViewBag.PublisherList)
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Danh mục cha</label>
                                <select id="ParentCategoryId" class="form-control" asp-items="ViewBag.ParentList">
                                    <option value="">-- Chọn danh mục --</option>
                                </select>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Danh mục con</label>
                                <select id="SubCategoryId" name="CategoryIds" class="form-control" disabled>
                                    <option value="">-- Chọn danh mục cha trước --</option>
                                </select>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Kích thước (D x R x C)</label>
                                <div class="input-group">
                                    <input type="text" class="form-control dimension-input" id="length" placeholder="D" name="Length">
                                    <span class="input-group-text">×</span>
                                    <input type="text" class="form-control dimension-input" id="width" placeholder="R" name="Width">
                                    <span class="input-group-text">×</span>
                                    <input type="text" class="form-control dimension-input" id="height" placeholder="C" name="Height">
                                    <span class="input-group-text">cm</span>
                                </div>
                            </div>
                            <div class="col-md-2 mb-3">
                                <label class="form-label">Trọng lượng</label>
                                <div class="input-group">
                                    <input type="text" id="weight" class="form-control dimension-input" placeholder="0" name="Weight">
                                    <span class="input-group-text">gram</span>
                                </div>
                            </div>
                            <div class="col-md-2 mb-3">
                                <label class="form-label">Ngôn ngữ</label>
                                <select id="language" class="form-select" name="Language">
                                    <option value="vi">Tiếng Việt</option>
                                    <option value="en">English</option>
                                </select>
                            </div>
                            <div class="col-md-2 mb-3">
                                <label class="form-label">Định dạng</label>
                                <select id="format" class="form-select" name="Format">
                                    <option value="paperback">Bìa mềm</option>
                                    <option value="hardcover">Bìa cứng</option>
                                    <option value="ebook">Ebook</option>
                                </select>
                            </div>
                            <div class="col-md-2 mb-3">
                                <label class="form-label">Số trang</label>
                                <input type="number" id="PageCount" class="form-control" name="PageCount" min="1" placeholder="0" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="Description" class="form-label">Mô tả</label>
                            <textarea id="Description" class="form-control" name="Description" rows="3" placeholder="Nhập mô tả sách..."></textarea>
                        </div>

                        <div class="text-end">
                            <button type="button" class="btn btn-primary" onclick="nextStep()">
                                Tiếp theo <i class="bi bi-arrow-right"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Step 2 -->
                    <div class="step" id="step-2">
                        <h5 class="mb-4">Bước 2: Giá & Tồn kho</h5>
                        
                        <div class="alert alert-info mb-4">
                            <i class="bi bi-info-circle"></i>
                            <strong>Lưu ý:</strong> Giá niêm yết (giá bìa) phải lớn hơn hoặc bằng giá bán thực tế.
                            <br><small>Bạn có thể nhập giá theo định dạng: 150000 hoặc 150.000</small>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Giá nhập (giá vốn) <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <input type="text" id="costprice" name="CostPrice" class="form-control required-field price-input" placeholder="VD: 50.000" />
                                    <span class="input-group-text">₫</span>
                                </div>
                                <small class="text-muted">Giá mua vào từ nhà cung cấp</small>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Giá niêm yết (giá bìa) <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <input type="text" id="listprice" name="ListPrice" class="form-control required-field price-input" placeholder="VD: 150.000" />
                                    <span class="input-group-text">₫</span>
                                </div>
                                <small class="text-muted">Giá gốc in trên bìa sách</small>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Giá bán thực tế <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <input type="text" id="saleprice" name="SalePrice" class="form-control required-field price-input" placeholder="VD: 120.000" />
                                    <span class="input-group-text">₫</span>
                                </div>
                                <small class="text-muted">Giá khách hàng phải trả (≤ giá niêm yết)</small>
                            </div>
                        </div>

                        <!-- Hiển thị % giảm giá -->
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <div class="card bg-light">
                                    <div class="card-body py-2">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span>Phần trăm giảm giá:</span>
                                            <span id="discountPercent" class="badge bg-secondary fs-6">0%</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Số lượng tồn kho <span class="text-danger">*</span></label>
                                <input type="number" id="inventory" name="Inventory" class="form-control required-field" min="0" placeholder="Số lượng" />
                            </div>
                        </div>

                        <!-- Thông báo lỗi giá -->
                        <div id="priceError" class="alert alert-danger d-none">
                            <i class="bi bi-exclamation-triangle"></i>
                            <span id="priceErrorMessage"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <button type="button" class="btn btn-secondary" onclick="prevStep()">
                                <i class="bi bi-arrow-left"></i> Quay lại
                            </button>
                            <button type="button" class="btn btn-primary" onclick="nextStep()">
                                Tiếp theo <i class="bi bi-arrow-right"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Step 3 -->
                    <div class="step" id="step-3">
                        <h5 class="mb-4">Bước 3: Xác nhận</h5>
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i> Vui lòng kiểm tra lại thông tin trước khi hoàn tất.
                        </div>
                        
                        <div class="form-check form-switch mb-4">
                            <input class="form-check-input" type="checkbox" id="PublishNow" name="PublishNowRawOk" />
                            <label class="form-check-label" for="PublishNow">
                                <strong>Xuất bản ngay?</strong> - Sách sẽ hiển thị trên website
                            </label>
                        </div>

                        <div class="d-flex justify-content-between">
                            <button type="button" class="btn btn-secondary" onclick="prevStep()">
                                <i class="bi bi-arrow-left"></i> Quay lại
                            </button>
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-circle"></i> Hoàn tất
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Book List Tab -->
    <div class="tab-pane fade" id="list" role="tabpanel">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-list"></i> Danh sách sách (@totalBooks)</h5>
                <div class="d-flex gap-2">
                    <select id="filterStock" class="form-select form-select-sm" style="width: auto;">
                        <option value="all">Tất cả</option>
                        <option value="instock">Còn hàng</option>
                        <option value="lowstock">Sắp hết</option>
                        <option value="outstock">Hết hàng</option>
                    </select>
                    <input type="text" class="form-control form-control-sm" placeholder="Tìm kiếm..." id="searchBook" style="width: 200px;" />
                </div>
            </div>
            <div class="card-body p-0">
                @if (Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0" id="bookTable">
                            <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>Sách</th>
                                    <th>Tác giả</th>
                                    <th>NXB</th>
                                    <th>Ngày XB</th>
                                    <th class="text-end">Giá bán</th>
                                    <th class="text-center">Tồn kho</th>
                                    <th class="text-center">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var book in Model.OrderByDescending(b => b.Id))
                                {
                                    var quantity = book.Inventory?.Quantity ?? 0;
                                    var stockStatus = quantity > 10 ? "instock" : quantity > 0 ? "lowstock" : "outstock";
                                    var badgeClass = quantity > 10 ? "bg-success" : quantity > 0 ? "bg-warning" : "bg-danger";
                                    var discount = book.ListPrice > 0 ? ((book.ListPrice - book.SalePrice) / book.ListPrice * 100) : 0;
                                    
                                    <tr data-stock="@stockStatus">
                                        <td>@book.Id</td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                @if (book.Images?.Any() == true)
                                                {
                                                    <img src="~/@book.Images.First().ImageUrl" alt="@book.Title" 
                                                         class="me-2 rounded" style="width: 40px; height: 55px; object-fit: cover;" />
                                                }
                                                else
                                                {
                                                    <div class="me-2 bg-light d-flex align-items-center justify-content-center rounded" 
                                                         style="width: 40px; height: 55px;">
                                                        <i class="bi bi-book text-muted"></i>
                                                    </div>
                                                }
                                                <div>
                                                    <a asp-action="Details" asp-route-id="@book.Id" class="text-decoration-none fw-medium">
                                                        @book.Title
                                                    </a>
                                                    <br />
                                                    <small class="text-muted">ISBN: @book.ISBN</small>
                                                    @if (!string.IsNullOrEmpty(book.Format))
                                                    {
                                                        <span class="badge bg-light text-dark ms-1">@(book.Format == "paperback" ? "Bìa mềm" : book.Format == "hardcover" ? "Bìa cứng" : book.Format)</span>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td>@(book.Authors?.FirstOrDefault()?.Author?.Name ?? "<em class='text-muted'>Chưa có</em>")</td>
                                        <td>@(book.Publisher?.Name ?? "<em class='text-muted'>Chưa có</em>")</td>
                                        <td>
                                            <small>@book.PublishDate.ToString("dd/MM/yyyy")</small>
                                        </td>
                                        <td class="text-end">
                                            @if (discount > 0)
                                            {
                                                <span class="text-decoration-line-through text-muted small">@book.ListPrice.ToString("N0") ₫</span>
                                                <span class="badge bg-danger ms-1">-@discount.ToString("0")%</span>
                                                <br />
                                            }
                                            <span class="fw-bold text-primary">@book.SalePrice.ToString("N0") ₫</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge @badgeClass">
                                                @quantity
                                            </span>
                                            @if (book.Inventory?.ReservedQuantity > 0)
                                            {
                                                <br />
                                                <small class="text-muted">(@book.Inventory.ReservedQuantity đặt)</small>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-group btn-group-sm">
                                                <a asp-action="Details" asp-route-id="@book.Id" class="btn btn-outline-primary" title="Xem">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-outline-warning" title="Sửa">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <form asp-action="Delete" asp-route-id="@book.Id" method="post" class="d-inline" 
                                                      onsubmit="return confirm('Bạn có chắc muốn xóa sách này?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-outline-danger" title="Xóa">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-inbox text-muted" style="font-size: 4rem;"></i>
                        <p class="text-muted mt-3">Chưa có sách nào trong hệ thống</p>
                        <button class="btn btn-primary" onclick="document.getElementById('book-tab').click()">
                            <i class="bi bi-plus-circle"></i> Thêm sách mới
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .step-indicator {
            gap: 10px;
        }
        .step-item {
            flex: 1;
            padding: 12px 20px;
            background: #e9ecef;
            border-radius: 8px;
            text-align: center;
            font-weight: 500;
