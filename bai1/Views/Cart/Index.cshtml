@model List<bai1.Models.CartItem>

@{
    ViewData["Title"] = "Giỏ hàng";
    var inventories = ViewBag.Inventories as Dictionary<int, int> ?? new Dictionary<int, int>();
    var insufficientItems = ViewBag.InsufficientItems as List<int> ?? new List<int>();
    // Không chặn đặt hàng dựa trên tồn kho - cho phép overselling
    var hasInsufficientStock = false;
}

<div class="container my-5">
    <div class="row">
        <div class="col-12">
            <h2 class="fw-bold mb-4"><i class="fas fa-shopping-cart"></i> Giỏ hàng của bạn</h2>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @Html.Raw(TempData["Error"])
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info text-center py-5">
                    <i class="fas fa-shopping-cart fa-3x mb-3 text-muted"></i>
                    <h4>Giỏ hàng trống</h4>
                    <p class="text-muted">Bạn chưa có sản phẩm nào trong giỏ hàng.</p>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">
                        <i class="fas fa-arrow-left"></i> Tiếp tục mua sắm
                    </a>
                </div>
            }
            else
            {
                <div class="row">
                    <div class="col-lg-8">
                        <div class="card shadow-sm mb-4">
                            <div class="card-body">
                                @foreach (var item in Model)
                                {
                                    var availableQty = inventories.GetValueOrDefault(item.BookId, 0);
                                    
                                    <div class="row align-items-center border-bottom py-3">

                                        <div class="col-md-2 col-3">
                                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                                            {
                                                <img src="~/@item.ImageUrl"
                                                     class="img-fluid rounded" 
                                                     alt="@item.Title"
                                                     style="max-height: 100px; object-fit: cover;" />
                                            }
                                            else
                                            {
                                                <div class="bg-light rounded d-flex align-items-center justify-content-center" 
                                                     style="height: 100px;">
                                                    <i class="fas fa-book fa-2x text-muted"></i>
                                                </div>
                                            }
                                        </div>
                                        <div class="col-md-4 col-9">
                                            <h5 class="mb-1">
                                                <a asp-controller="Book" asp-action="Details" asp-route-id="@item.BookId" 
                                                   class="text-decoration-none text-dark">
                                                    @item.Title
                                                </a>
                                            </h5>
                                            <p class="text-muted mb-0">@item.Price.ToString("N0")đ</p>
                                            @if (availableQty > 0)
                                            {
                                                <small class="text-success">
                                                    <i class="fas fa-check-circle"></i> Còn @availableQty sản phẩm
                                                </small>
                                            }
                                            else
                                            {
                                                <small class="text-warning">
                                                    <i class="fas fa-clock"></i> Đặt trước - sẽ giao khi có hàng
                                                </small>
                                            }
                                        </div>
                                        <div class="col-md-3 col-6 mt-2 mt-md-0">
                                            <form method="post" asp-action="UpdateQuantity" class="d-flex align-items-center">
                                                <input type="hidden" name="bookId" value="@item.BookId" />
                                                <input type="number" 
                                                       name="quantity" 
                                                       value="@item.Quantity" 
                                                       min="1" 
                                                       class="form-control form-control-sm me-2" 
                                                       style="max-width: 80px;"
                                                       onchange="this.form.submit()" />
                                                <span class="text-muted small">x @item.Price.ToString("N0")đ</span>
                                            </form>
                                        </div>
                                        <div class="col-md-2 col-4 mt-2 mt-md-0 text-end">
                                            <strong class="text-primary">@((item.Price * item.Quantity).ToString("N0"))đ</strong>
                                        </div>
                                        <div class="col-md-1 col-2 mt-2 mt-md-0 text-end">
                                            <form method="post" asp-action="Remove" class="d-inline">
                                                <input type="hidden" name="bookId" value="@item.BookId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" 
                                                        onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này?')">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left"></i> Tiếp tục mua sắm
                            </a>
                            <form method="post" asp-action="Clear" class="d-inline">
                                <button type="submit" class="btn btn-outline-danger"
                                        onclick="return confirm('Bạn có chắc muốn xóa toàn bộ giỏ hàng?')">
                                    <i class="fas fa-trash-alt"></i> Xóa giỏ hàng
                                </button>
                            </form>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="card shadow-sm sticky-top" style="top: 20px;">
                            <div class="card-header bg-primary text-white">
                                <h5 class="mb-0"><i class="fas fa-receipt"></i> Tóm tắt đơn hàng</h5>
                            </div>
                            <div class="card-body">
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Tổng sản phẩm:</span>
                                    <strong>@Model.Count</strong>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Tổng số lượng:</span>
                                    <strong>@Model.Sum(i => i.Quantity)</strong>
                                </div>
                                <hr />
                                <div class="d-flex justify-content-between mb-3">
                                    <span>Tạm tính:</span>
                                    <strong>@ViewBag.Total.ToString("N0")đ</strong>
                                </div>
                                <div class="d-flex justify-content-between mb-3">
                                    <span>Phí vận chuyển:</span>
                                    <strong class="text-success">Miễn phí</strong>
                                </div>
                                <hr />
                                <div class="d-flex justify-content-between mb-3">
                                    <h5 class="mb-0">Tổng cộng:</h5>
                                    <h5 class="mb-0 text-primary">@ViewBag.Total.ToString("N0")đ</h5>
                                </div>
                                
                                <a asp-controller="Checkout" asp-action="Index" class="btn btn-primary w-100 mb-2">
                                    <i class="fas fa-check"></i> Tiến hành thanh toán
                                </a>
                                
                                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary w-100">
                                    <i class="fas fa-arrow-left"></i> Tiếp tục mua sắm
                                </a>
                            </div>
                        </div>

                        <div class="card shadow-sm mt-3">
                            <div class="card-body">
                                <h6 class="fw-bold mb-3"><i class="fas fa-tags"></i> Mã giảm giá</h6>
                                <div class="input-group">
                                    <input type="text" class="form-control" placeholder="Nhập mã giảm giá">
                                    <button class="btn btn-outline-primary" type="button">
                                        Áp dụng
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

