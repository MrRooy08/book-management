@model bai1.Models.Order

@{
    ViewData["Title"] = "Chi Tiết Đơn Hàng #" + Model.Id;
    var phone = ViewBag.Phone as string;
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col-12">
            <a asp-action="Search" asp-route-phone="@phone" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Quay lại danh sách
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <!-- Order Status Card -->
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-truck"></i> Trạng Thái Đơn Hàng #@Model.Id
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.OrderStatus == "Cancelled")
                    {
                        <div class="alert alert-danger">
                            <h6><i class="bi bi-x-circle-fill"></i> Đơn hàng đã bị hủy</h6>
                            @if (Model.CancelledAt != null)
                            {
                                <small>Thời gian: @Model.CancelledAt.Value.ToString("dd/MM/yyyy HH:mm")</small>
                            }
                            @if (!string.IsNullOrEmpty(Model.CancelReason))
                            {
                                <p class="mb-0 mt-2"><strong>Lý do:</strong> @Model.CancelReason</p>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="order-tracking">
                            <div class="tracking-item @(Model.OrderStatus == "Pending" ? "active" : "completed")">
                                <div class="tracking-icon">
                                    <i class="bi bi-clock-fill"></i>
                                </div>
                                <div class="tracking-content">
                                    <h6>Đơn hàng đã đặt</h6>
                                    <small class="text-muted">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                                </div>
                            </div>

                            <div class="tracking-item @(Model.OrderStatus == "Confirmed" ? "active" : (new[] {"Processing", "Shipping", "Delivered"}.Contains(Model.OrderStatus) ? "completed" : ""))">
                                <div class="tracking-icon">
                                    <i class="bi bi-check-circle-fill"></i>
                                </div>
                                <div class="tracking-content">
                                    <h6>Đã xác nhận</h6>
                                    <small class="text-muted">Đơn hàng đã được xác nhận</small>
                                </div>
                            </div>

                            <div class="tracking-item @(Model.OrderStatus == "Processing" ? "active" : (new[] {"Shipping", "Delivered"}.Contains(Model.OrderStatus) ? "completed" : ""))">
                                <div class="tracking-icon">
                                    <i class="bi bi-box-seam-fill"></i>
                                </div>
                                <div class="tracking-content">
                                    <h6>Đang chuẩn bị hàng</h6>
                                    <small class="text-muted">Nhà bán hàng đang chuẩn bị đơn hàng</small>
                                </div>
                            </div>

                            <div class="tracking-item @(Model.OrderStatus == "Shipping" ? "active" : (Model.OrderStatus == "Delivered" ? "completed" : ""))">
                                <div class="tracking-icon">
                                    <i class="bi bi-truck"></i>
                                </div>
                                <div class="tracking-content">
                                    <h6>Đang giao hàng</h6>
                                    <small class="text-muted">Đơn vị vận chuyển đang giao đến bạn</small>
                                </div>
                            </div>

                            <div class="tracking-item @(Model.OrderStatus == "Delivered" ? "completed" : "")">
                                <div class="tracking-icon">
                                    <i class="bi bi-check2-all"></i>
                                </div>
                                <div class="tracking-content">
                                    <h6>Đã giao hàng</h6>
                                    @if (Model.DeliveredAt != null)
                                    {
                                        <small class="text-muted">@Model.DeliveredAt.Value.ToString("dd/MM/yyyy HH:mm")</small>
                                    }
                                    else
                                    {
                                        <small class="text-muted">Giao hàng thành công</small>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Order Items -->
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="bi bi-bag"></i> Sản Phẩm Đã Đặt</h5>
                </div>
                <div class="card-body">
                    @foreach (var item in Model.OrderDetails)
                    {
                        <div class="row mb-3 pb-3 border-bottom align-items-center">
                            <div class="col-3 col-md-2">
                                @if (item.Book?.Images?.Any() == true)
                                {
                                    <img src="~/@item.Book.Images.First().ImageUrl" 
                                         alt="@item.BookTitle" 
                                         class="img-fluid rounded" />
                                }
                                else
                                {
                                    <div class="bg-light rounded d-flex align-items-center justify-content-center"
                                         style="height: 80px;">
                                        <i class="bi bi-book text-muted" style="font-size: 2rem;"></i>
                                    </div>
                                }
                            </div>
                            <div class="col-5 col-md-6">
                                <h6 class="mb-1">@item.BookTitle</h6>
                                <p class="text-muted mb-0 small">Số lượng: @item.Quantity</p>
                            </div>
                            <div class="col-4 text-end">
                                <p class="mb-0 small text-muted">@item.Price.ToString("N0") ₫/cuốn</p>
                                <p class="fw-bold text-primary mb-0">@item.Subtotal.ToString("N0") ₫</p>
                            </div>
                        </div>
                    }

                    <!-- Tổng cộng -->
                    <div class="mt-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Tạm tính:</span>
                            <span>@((Model.TotalAmount - Model.ShippingFee + Model.DiscountAmount).ToString("N0")) ₫</span>
                        </div>
                        @if (Model.ShippingFee > 0)
                        {
                            <div class="d-flex justify-content-between mb-2">
                                <span>Phí vận chuyển:</span>
                                <span>@Model.ShippingFee.ToString("N0") ₫</span>
                            </div>
                        }
                        @if (Model.DiscountAmount > 0)
                        {
                            <div class="d-flex justify-content-between mb-2 text-success">
                                <span>Giảm giá:</span>
                                <span>-@Model.DiscountAmount.ToString("N0") ₫</span>
                            </div>
                        }
                        <hr />
                        <div class="d-flex justify-content-between">
                            <h5>Tổng cộng:</h5>
                            <h4 class="text-primary fw-bold">@Model.TotalAmount.ToString("N0") ₫</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Delivery Info -->
            <div class="card mb-3 shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="bi bi-geo-alt"></i> Địa Chỉ Nhận Hàng</h5>
                </div>
                <div class="card-body">
                    <h6 class="fw-bold">@Model.CustomerName</h6>
                    <p class="mb-1">
                        <i class="bi bi-telephone text-primary"></i> @Model.Phone
                    </p>
                    <p class="mb-2">
                        <i class="bi bi-envelope text-primary"></i> @Model.Email
                    </p>
                    <hr />
                    <p class="mb-0">
                        <i class="bi bi-house text-primary"></i> @Model.ShippingAddress
                    </p>
                    @if (!string.IsNullOrEmpty(Model.Note))
                    {
                        <hr />
                        <div class="bg-light p-2 rounded">
                            <small class="text-muted"><i class="bi bi-sticky"></i> Ghi chú:</small>
                            <p class="mb-0 small"><em>@Model.Note</em></p>
                        </div>
                    }
                </div>
            </div>

            <!-- Payment Info -->
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="bi bi-credit-card"></i> Thông Tin Thanh Toán</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <strong>Phương thức:</strong>
                        @if (Model.PaymentMethod == "COD")
                        {
                            <br />
                            <span class="badge bg-warning text-dark mt-1">
                                <i class="bi bi-cash-coin"></i> Thanh toán khi nhận hàng (COD)
                            </span>
                        }
                        else
                        {
                            <br />
                            <span class="badge bg-info mt-1">
                                <i class="bi bi-credit-card"></i> VNPay
                            </span>
                        }
                    </div>
                    <div>
                        <strong>Trạng thái:</strong>
                        @if (Model.PaymentStatus == "Paid")
                        {
                            <br />
                            <span class="badge bg-success mt-1">
                                <i class="bi bi-check-circle-fill"></i> Đã thanh toán
                            </span>
                            @if (Model.PaidAt != null)
                            {
                                <br />
                                <small class="text-muted">Lúc @Model.PaidAt.Value.ToString("dd/MM/yyyy HH:mm")</small>
                            }
                        }
                        else if (Model.PaymentStatus == "Failed")
                        {
                            <br />
                            <span class="badge bg-danger mt-1">
                                <i class="bi bi-x-circle"></i> Thanh toán thất bại
                            </span>
                        }
                        else if (Model.PaymentStatus == "Refunded")
                        {
                            <br />
                            <span class="badge bg-secondary mt-1">
                                <i class="bi bi-arrow-counterclockwise"></i> Đã hoàn tiền
                            </span>
                        }
                        else
                        {
                            <br />
                            <span class="badge bg-warning text-dark mt-1">
                                <i class="bi bi-clock"></i> Chưa thanh toán
                            </span>
                        }
                    </div>
                </div>
            </div>

            <!-- Hỗ trợ -->
            <div class="card mt-3 border-info">
                <div class="card-body text-center">
                    <i class="bi bi-headset text-info" style="font-size: 2rem;"></i>
                    <h6 class="mt-2">Cần hỗ trợ?</h6>
                    <p class="small text-muted mb-2">Liên hệ hotline để được hỗ trợ</p>
                    <a href="tel:1900xxxx" class="btn btn-outline-info btn-sm">
                        <i class="bi bi-telephone"></i> 1900 xxxx
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .order-tracking {
            position: relative;
            padding: 20px 0;
        }

        .tracking-item {
            display: flex;
            align-items: flex-start;
            margin-bottom: 30px;
            position: relative;
        }

        .tracking-item::before {
            content: '';
            position: absolute;
            left: 23px;
            top: 50px;
            width: 2px;
            height: calc(100% + 10px);
            background: #dee2e6;
        }

        .tracking-item:last-child::before {
            display: none;
        }

        .tracking-item.active::before,
        .tracking-item.completed::before {
            background: #28a745;
        }

        .tracking-icon {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: #e9ecef;
            color: #6c757d;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            margin-right: 20px;
            z-index: 1;
            position: relative;
            flex-shrink: 0;
        }

        .tracking-item.active .tracking-icon {
            background: #ffc107;
            color: #fff;
            animation: pulse 1.5s infinite;
        }

        .tracking-item.completed .tracking-icon {
            background: #28a745;
            color: #fff;
        }

        @@keyframes pulse {
            0%, 100% {
                box-shadow: 0 0 0 0 rgba(255, 193, 7, 0.7);
            }
            50% {
                box-shadow: 0 0 0 10px rgba(255, 193, 7, 0);
            }
        }

        .tracking-content h6 {
            margin-bottom: 5px;
            font-weight: 600;
        }

        .tracking-item.active .tracking-content h6 {
            color: #ffc107;
            font-weight: 700;
        }

        .tracking-item.completed .tracking-content h6 {
            color: #28a745;
        }
    </style>
}
