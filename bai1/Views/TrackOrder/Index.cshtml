@{
    ViewData["Title"] = "Tra Cứu Đơn Hàng";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white text-center py-4">
                    <i class="bi bi-search" style="font-size: 3rem;"></i>
                    <h3 class="mb-0 mt-2">Tra Cứu Đơn Hàng</h3>
                    <p class="mb-0 mt-2 opacity-75">Nhập số điện thoại để xem trạng thái đơn hàng</p>
                </div>
                <div class="card-body p-4">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-circle-fill me-2"></i>@TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="Search" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-4">
                            <label for="phone" class="form-label fw-bold">
                                <i class="bi bi-telephone"></i> Số Điện Thoại
                            </label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text"><i class="bi bi-phone"></i></span>
                                <input type="tel" 
                                       class="form-control" 
                                       id="phone" 
                                       name="phone" 
                                       placeholder="VD: 0901234567"
                                       value="@TempData["SearchPhone"]"
                                       pattern="[0-9]{10,11}"
                                       maxlength="11"
                                       required />
                            </div>
                            <small class="text-muted">Nhập số điện thoại bạn đã sử dụng khi đặt hàng</small>
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-search me-2"></i>Tra Cứu
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Hướng dẫn -->
            <div class="card mt-4 border-0 bg-light">
                <div class="card-body">
                    <h6 class="fw-bold"><i class="bi bi-info-circle"></i> Hướng dẫn</h6>
                    <ul class="mb-0 small">
                        <li>Nhập chính xác số điện thoại bạn đã dùng khi đặt hàng</li>
                        <li>Hệ thống sẽ hiển thị tất cả đơn hàng liên quan đến số điện thoại</li>
                        <li>Bạn có thể xem chi tiết và theo dõi trạng thái từng đơn hàng</li>
                    </ul>
                </div>
            </div>

            <!-- Nếu đã đăng nhập -->
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="text-center mt-4">
                    <p class="text-muted">Bạn đã đăng nhập?</p>
                    <a asp-controller="MyOrder" asp-action="Index" class="btn btn-outline-primary">
                        <i class="bi bi-list-check"></i> Xem đơn hàng của tôi
                    </a>
                </div>
            }
        </div>
    </div>
</div>
