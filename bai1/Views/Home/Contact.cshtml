@{
    ViewData["Title"] = "Liên hệ";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-12">
            <h1 class="mb-4 fw-bold">@ViewData["Title"]</h1>

            <div class="row">

                <!-- FORM LIÊN HỆ -->
                <div class="col-md-8 mb-4">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h2 class="card-title mb-4">Liên hệ với chúng tôi</h2>

                            <form>
                                <div class="mb-3">
                                    <label for="name" class="form-label">
                                        Họ và tên <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" class="form-control" id="name" name="name" required>
                                </div>

                                <div class="mb-3">
                                    <label for="email" class="form-label">
                                        Email <span class="text-danger">*</span>
                                    </label>
                                    <input type="email" class="form-control" id="email" name="email" required>
                                </div>

                                <div class="mb-3">
                                    <label for="subject" class="form-label">Tiêu đề</label>
                                    <input type="text" class="form-control" id="subject" name="subject">
                                </div>

                                <div class="mb-3">
                                    <label for="message" class="form-label">
                                        Nội dung <span class="text-danger">*</span>
                                    </label>
                                    <textarea class="form-control" id="message" name="message" rows="5" required></textarea>
                                </div>

                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-paper-plane"></i> Gửi tin nhắn
                                </button>
                            </form>
                            <hr class="my-4" />
                            <h5 class="fw-bold mb-3">
                                <i class="fas fa-map-marked-alt text-primary"></i> Bản đồ vị trí công ty
                            </h5>
                            <div class="ratio ratio-16x9">
                                <iframe src="https://www.google.com/maps?q=10.856923762097917,106.76550506661377&output=embed"
                                        style="border:0;"
                                        allowfullscreen=""
                                        loading="lazy"
                                        referrerpolicy="no-referrer-when-downgrade">
                                </iframe>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- THÔNG TIN LIÊN HỆ -->
                <div class="col-md-4 mb-4">

                    <!-- THÔNG TIN CÔNG TY -->
