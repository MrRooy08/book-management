@model bai1.Models.Dto.HomeIndexViewModel

@{
    ViewData["Title"] = ViewBag.CategoryName;
}

<div class="container">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">@ViewBag.CategoryName</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="fas fa-book me-2"></i>@ViewBag.CategoryName
        </h2>
        <span class="badge bg-primary">@Model.TotalBooks sách</span>
    </div>

    @if (Model.Books != null && Model.Books.Any())
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var book in Model.Books)
            {
                var primaryImage = book.Images?.FirstOrDefault(i => i.IsPrimary) ?? book.Images?.FirstOrDefault();
                var discount = 0m;
                if (book.ListPrice > 0)
                {
                    discount = ((book.ListPrice - book.SalePrice) / book.ListPrice) * 100;
                }

                <div class="col">
                    <div class="card h-100 book-card">
                        <a asp-controller="Book" asp-action="Details" asp-route-id="@book.Id" class="text-decoration-none">
                            <div class="position-relative">
                                <img src="@(primaryImage != null ? "/Images/" + primaryImage.ImageUrl : "/images/no-image.png")" 
                                     class="card-img-top" alt="@book.Title" style="height: 300px; object-fit: cover;">
                                @if (discount > 0)
                                {
                                    <span class="badge bg-danger position-absolute top-0 end-0 m-2">
                                        -@discount.ToString("0")%
                                    </span>
                                }
                            </div>
                            <div class="card-body">
                                <h6 class="card-title text-dark" style="height: 48px; overflow: hidden;">@book.Title</h6>
                                @if (book.Authors != null && book.Authors.Any())
                                {
                                    <p class="card-text text-muted small mb-2">
                                        @string.Join(", ", book.Authors.Select(a => a.Author?.Name))
                                    </p>
                                }
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        @if (book.ListPrice > book.SalePrice)
                                        {
                                            <span class="text-muted text-decoration-line-through small">@book.ListPrice.ToString("N0")đ</span><br />
                                        }
                                        <span class="text-danger fw-bold">@book.SalePrice.ToString("N0")đ</span>
                                    </div>
                                </div>
                            </div>
                        </a>
                        <div class="card-footer bg-white border-top-0">
                            <button class="btn btn-primary btn-sm w-100" onclick="location.href='@Url.Action("Details", "Book", new { id = book.Id })'">
                                <i class="fas fa-eye me-1"></i>Xem chi tiết
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Pagination *@
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Page navigation" class="mt-5">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="BooksByCategory" asp-route-categoryId="@ViewBag.CategoryId" asp-route-pageNumber="@(Model.CurrentPage - 1)">
                            <i class="fas fa-chevron-left"></i>
                        </a>
                    </li>

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="BooksByCategory" asp-route-categoryId="@ViewBag.CategoryId" asp-route-pageNumber="@i">@i</a>
                        </li>
                    }

                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="BooksByCategory" asp-route-categoryId="@ViewBag.CategoryId" asp-route-pageNumber="@(Model.CurrentPage + 1)">
                            <i class="fas fa-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="alert alert-info text-center" role="alert">
            <i class="fas fa-info-circle me-2"></i>
            Hiện chưa có sách nào trong danh mục này.
        </div>
    }
</div>

<style>
    .book-card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .book-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .breadcrumb {
        background-color: #f8f9fa;
        padding: 0.75rem 1rem;
        border-radius: 0.25rem;
    }
</style>
