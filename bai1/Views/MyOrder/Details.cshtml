@model bai1.Models.Order

@{
    ViewData["Title"] = "Chi Tiết Đơn Hàng #" + Model.Id;
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col-12">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Quay lại danh sách
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-lg-8">
            <!-- Order Status Card -->
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="bi bi-truck"></i> Trạng Thái Đơn Hàng #@Model.Id
                    </h5>
                </div>
                <div class="card-body">
                    <div class="order-tracking">
                        <div class="tracking-item @(Model.OrderStatus == "Pending" ? "active" : "completed")">
                            <div class="tracking-icon">
                                <i class="bi bi-clock-fill"></i>
                            </div>
                            <div class="tracking-content">
                                <h6>Đơn hàng đã đặt</h6>
                                <small class="text-muted">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                            </div>
                        </div>

                        <div class="tracking-item @(Model.OrderStatus == "Confirmed" ? "active" : (new[] {"Processing", "Shipping", "Delivered"}.Contains(Model.OrderStatus) ? "completed" : ""))">
                            <div class="tracking-icon">
                                <i class="bi bi-check-circle-fill"></i>
                            </div>
                            <div class="tracking-content">
                                <h6>Đã xác nhận</h6>
                                <small class="text-muted">Đơn hàng đã được xác nhận</small>
                            </div>
                        </div>

                        <div class="tracking-item @(Model.OrderStatus == "Processing" ? "active" : (new[] {"Shipping", "Delivered"}.Contains(Model.OrderStatus) ? "completed" : ""))">
                            <div class="tracking-icon">
                                <i class="bi bi-box-seam-fill"></i>
                            </div>
                            <div class="tracking-content">
                                <h6>Đang chuẩn bị hàng</h6>
                                <small class="text-muted">Nhà bán hàng đang chuẩn bị</small>
                            </div>
                        </div>

                        <div class="tracking-item @(Model.OrderStatus == "Shipping" ? "active" : (Model.OrderStatus == "Delivered" ? "completed" : ""))">
                            <div class="tracking-icon">
                                <i class="bi bi-truck"></i>
                            </div>
                            <div class="tracking-content">
                                <h6>Đang giao hàng</h6>
                                <small class="text-muted">Đơn vị vận chuyển đang giao</small>
                            </div>
                        </div>

                        <div class="tracking-item @(Model.OrderStatus == "Delivered" ? "completed" : "")">
                            <div class="tracking-icon">
                                <i class="bi bi-check2-all"></i>
                            </div>
                            <div class="tracking-content">
                                <h6>Đã giao hàng</h6>
                                @if (Model.DeliveredAt != null)
                                {
                                    <small class="text-muted">@Model.DeliveredAt.Value.ToString("dd/MM/yyyy HH:mm")</small>
                                }
                            </div>
                        </div>
                    </div>

                    @if (Model.OrderStatus == "Cancelled")
                    {
                        <div class="alert alert-danger mt-4">
                            <h6><i class="bi bi-x-circle"></i> Đơn hàng đã bị hủy</h6>
                            @if (Model.CancelledAt != null)
                            {
                                <small>Thời gian: @Model.CancelledAt.Value.ToString("dd/MM/yyyy HH:mm")</small>
                            }
                            @if (!string.IsNullOrEmpty(Model.CancelReason))
                            {
                                <p class="mb-0 mt-2"><strong>Lý do:</strong> @Model.CancelReason</p>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Order Items -->
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="bi bi-bag"></i> Sản Phẩm</h5>
                </div>
                <div class="card-body">
                    @foreach (var item in Model.OrderDetails)
                    {
                        <div class="row mb-3 pb-3 border-bottom">
                            <div class="col-md-2">
                                @if (item.Book?.Images?.Any() == true)
                                {
                                    <img src="~/@item.Book.Images.First().ImageUrl" 
                                         alt="@item.BookTitle" 
                                         class="img-fluid rounded" />
                                }
                            </div>
                            <div class="col-md-6">
                                <h6>@item.BookTitle</h6>
                                <p class="text-muted mb-0">Số lượng: @item.Quantity</p>
                            </div>
                            <div class="col-md-4 text-end">
                                <p class="mb-0">@item.Price.ToString("N0") ₫</p>
                                <p class="fw-bold text-primary">@item.Subtotal.ToString("N0") ₫</p>
                            </div>
                        </div>
                    }
                    <div class="row mt-3">
                        <div class="col-md-8">
                            <h5>Tổng cộng:</h5>
                        </div>
                        <div class="col-md-4 text-end">
                            <h4 class="text-primary">@Model.TotalAmount.ToString("N0") ₫</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Delivery Info -->
            <div class="card mb-3">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="bi bi-geo-alt"></i> Địa Chỉ Nhận Hàng</h5>
                </div>
                <div class="card-body">
                    <h6>@Model.CustomerName</h6>
                    <p class="mb-1">
                        <i class="bi bi-telephone"></i> @Model.Phone
                    </p>
                    <p class="mb-0">
                        <i class="bi bi-envelope"></i> @Model.Email
                    </p>
                    <hr />
                    <p class="mb-0">@Model.ShippingAddress</p>
                    @if (!string.IsNullOrEmpty(Model.Note))
                    {
                        <hr />
                        <p class="mb-0">
                            <strong>Ghi chú:</strong><br />
                            <em>@Model.Note</em>
                        </p>
                    }
                </div>
            </div>

            <!-- Payment Info -->
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="bi bi-credit-card"></i> Thanh Toán</h5>
                </div>
                <div class="card-body">
                    <p>
                        <strong>Phương thức:</strong>
                        @if (Model.PaymentMethod == "COD")
                        {
                            <br />
                            <span class="badge bg-warning text-dark mt-1">
                                <i class="bi bi-cash"></i> Thanh toán khi nhận hàng
                            </span>
                        }
                        else
                        {
                            <br />
                            <span class="badge bg-info mt-1">
                                <i class="bi bi-credit-card"></i> VNPay
                            </span>
                        }
                    </p>
                    <p class="mb-0">
                        <strong>Trạng thái:</strong>
                        @if (Model.PaymentStatus == "Paid")
                        {
                            <br />
                            <span class="badge bg-success mt-1">
                                <i class="bi bi-check-circle"></i> Đã thanh toán
                            </span>
                            @if (Model.PaidAt != null)
                            {
                                <br />
                                <small class="text-muted">@Model.PaidAt.Value.ToString("dd/MM/yyyy HH:mm")</small>
                            }
                        }
                        else
                        {
                            <br />
                            <span class="badge bg-secondary mt-1">Chưa thanh toán</span>
                        }
                    </p>
                </div>
            </div>

            @if ((Model.OrderStatus == "Pending" || Model.OrderStatus == "Confirmed") && Model.OrderStatus != "Cancelled")
            {
                <div class="card mt-3 border-danger">
                    <div class="card-body text-center">
                        <button type="button" class="btn btn-danger w-100" data-bs-toggle="modal" data-bs-target="#cancelModal">
                            <i class="bi bi-x-circle"></i> Hủy đơn hàng
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Cancel Modal -->
<div class="modal fade" id="cancelModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CancelOrder" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="modal-header">
                    <h5 class="modal-title">Hủy Đơn Hàng</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle"></i> 
                        Bạn có chắc chắn muốn hủy đơn hàng này không?
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Lý do hủy đơn <span class="text-danger">*</span></label>
                        <select name="reason" class="form-select" required>
                            <option value="">-- Chọn lý do --</option>
                            <option value="Muốn thay đổi sản phẩm">Muốn thay đổi sản phẩm</option>
                            <option value="Tìm được giá rẻ hơn">Tìm được giá rẻ hơn</option>
                            <option value="Đặt nhầm">Đặt nhầm</option>
                            <option value="Thay đổi địa chỉ giao hàng">Thay đổi địa chỉ giao hàng</option>
                            <option value="Khác">Lý do khác</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-danger">Xác nhận hủy</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .order-tracking {
            position: relative;
            padding: 20px 0;
        }

        .tracking-item {
            display: flex;
            align-items: flex-start;
            margin-bottom: 30px;
            position: relative;
        }

        .tracking-item::before {
            content: '';
            position: absolute;
            left: 23px;
            top: 50px;
            width: 2px;
            height: calc(100% + 10px);
            background: #dee2e6;
        }

        .tracking-item:last-child::before {
            display: none;
        }

        .tracking-item.active::before,
        .tracking-item.completed::before {
            background: #28a745;
        }

        .tracking-icon {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: #e9ecef;
            color: #6c757d;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            margin-right: 20px;
            z-index: 1;
            position: relative;
        }

        .tracking-item.active .tracking-icon {
            background: #ffc107;
            color: #fff;
            animation: pulse 1.5s infinite;
        }

        .tracking-item.completed .tracking-icon {
            background: #28a745;
            color: #fff;
        }

        @@keyframes pulse {
            0%, 100% {
                box-shadow: 0 0 0 0 rgba(255, 193, 7, 0.7);
            }
            50% {
                box-shadow: 0 0 0 10px rgba(255, 193, 7, 0);
            }
        }

        .tracking-content h6 {
            margin-bottom: 5px;
            font-weight: 600;
        }

        .tracking-item.active .tracking-content h6 {
            color: #ffc107;
            font-weight: 700;
        }

        .tracking-item.completed .tracking-content h6 {
            color: #28a745;
        }
    </style>
}
